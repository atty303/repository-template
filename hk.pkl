amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

min_hk_version = "1.55.0"

local linters = new Mapping<String, Step> {
  ["archetect:interface"] {
    glob = List("archetype.lua", "archetype.yaml", "shared/**/*", "base/**/*", "deno/**/*", "deno-release/**/*")
    check = new Command { argv = List("archetect", "interface", ".", "--json", "--explore") }
  }
  ["actionlint"] = (Builtins.actionlint) {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = new Command { argv = List("actionlint", "-shellcheck=", "{{files}}") }
  }
  ["case-conflict"] = Builtins.check_case_conflict
  ["deno:check"] {
    glob = "scripts/*.ts"
    check = new Command { argv = List("deno", "check", "{{files}}") }
  }
  ["deno:fmt"] {
    glob = List("scripts/*.ts", "README.md")
    stage = glob
    check = new Command { argv = List("deno", "fmt", "--check", "{{files}}") }
    fix = new Command { argv = List("deno", "fmt", "{{files}}") }
  }
  ["deno:lint"] {
    glob = "scripts/*.ts"
    stage = glob
    check = new Command { argv = List("deno", "lint", "{{files}}") }
    fix = new Command { argv = List("deno", "lint", "--fix", "{{files}}") }
  }
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["mise"] = Builtins.mise
  ["private-key"] = Builtins.detect_private_key
  ["taplo"] = (Builtins.taplo) {
    glob = "mise.toml"
  }
}

hooks {
  ["pre-commit"] { fix = true; stash = "git"; steps = linters }
  ["check"] { steps = linters }
  ["fix"] { fix = true; steps = linters }
}
