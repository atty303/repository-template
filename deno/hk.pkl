{% raw %}amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

min_hk_version = "1.55.0"

local linters = new Mapping<String, Step> {
  ["actionlint"] = (Builtins.actionlint) {
    check = new CommandSpec {
      command = new Command { argv = List("actionlint", "-shellcheck=", "{{files}}") }
      effect = "read"
    }
  }
  ["case-conflict"] = Builtins.check_case_conflict
  ["deno:check"] {
    glob = List("*.js", "*.jsx", "*.mts", "*.ts", "*.tsx")
    check = new CommandSpec {
      command = new Command { argv = List("deno", "check", "--doc", "{{files}}") }
      effect = "read"
    }
  }
  ["deno:fmt"] {
    glob = List("*.js", "*.jsx", "*.json", "*.jsonc", "*.md", "*.mts", "*.ts", "*.tsx")
    stage = glob
    check = new CommandSpec {
      command = new Command { argv = List("deno", "fmt", "--check", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = List("deno", "fmt", "{{files}}") }
      effect = "write"
    }
  }
  ["deno:lint"] {
    glob = List("*.js", "*.jsx", "*.mts", "*.ts", "*.tsx")
    stage = glob
    check = new CommandSpec {
      command = new Command { argv = List("deno", "lint", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = List("deno", "lint", "--fix", "{{files}}") }
      effect = "write"
    }
  }
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["mise"] = Builtins.mise
  ["private-key"] = Builtins.detect_private_key
  ["taplo"] = Builtins.taplo
}
{% endraw %}

hooks {
  ["pre-commit"] { fix = true; stash = "git"; steps = linters }
  ["check"] { steps = linters }
  ["fix"] { fix = true; steps = linters }
}
